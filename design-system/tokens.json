{
  "$description": "Evidence Folio 2.0, the design tokens of the DLMP AI Policy Explorer. Brand values are the chair's specified UW Purple and UW Gold; ramps are derived in OKLCH at the same hue. Values marked source come from the original page's stylesheet.",
  "color": {
    "brand": {
      "uw-purple": { "$type": "color", "$value": "#4b2e83", "$description": "Source. oklch(0.385 0.136 295). Brand field, primary actions, links, table header, selected state." },
      "uw-gold": { "$type": "color", "$value": "#b7a57a", "$description": "Source. oklch(0.727 0.062 88). Rules, ornament, focus halo. Text only at 24px+ on UW Purple (4.30:1) or at any size on Purple 900 (6.54:1)." }
    },
    "purple": {
      "950": { "$type": "color", "$value": "#1b0d35", "$description": "Footer field." },
      "900": { "$type": "color", "$value": "#2a164f", "$description": "Deep band; UW Gold text is AA here." },
      "800": { "$type": "color", "$value": "#392068", "$description": "Hover and pressed." },
      "700": { "$type": "color", "$value": "{color.brand.uw-purple}", "$description": "UW Purple." },
      "600": { "$type": "color", "$value": "#6246a0", "$description": "Secondary marks." },
      "300": { "$type": "color", "$value": "#b9b0da", "$description": "Marks and captions on dark purple." },
      "200": { "$type": "color", "$value": "#d8d4ec", "$description": "Selection, text on Purple 900." },
      "100": { "$type": "color", "$value": "#f0ebf6", "$description": "Source (soft). Tags, chip hover, agenda panel." },
      "50": { "$type": "color", "$value": "#f7f6fc", "$description": "Filter rail, date rails, selected tiles." }
    },
    "gold": {
      "900": { "$type": "color", "$value": "#534627", "$description": "Text on the draft-proposal hatch." },
      "800": { "$type": "color", "$value": "#685933", "$description": "Gold labels on light grounds, 6.46:1 on paper." },
      "700": { "$type": "color", "$value": "#847348", "$description": "Large numerals, quotation marks, icons; 4.37:1 on paper (large text and non-text only)." },
      "500": { "$type": "color", "$value": "{color.brand.uw-gold}", "$description": "UW Gold." },
      "300": { "$type": "color", "$value": "#dbcdab", "$description": "Small gold text on UW Purple, 6.61:1." },
      "200": { "$type": "color", "$value": "#e9dfc7", "$description": "Hatch stripe." },
      "100": { "$type": "color", "$value": "#f6f0e1", "$description": "Analyst-interpretation wash." }
    },
    "neutral": {
      "ink": { "$type": "color", "$value": "#23202b", "$description": "Source. Primary text, 15.08:1 on paper." },
      "ink-2": { "$type": "color", "$value": "#3a3542", "$description": "Body copy inside cards, 11.20:1." },
      "muted": { "$type": "color", "$value": "#57515f", "$description": "Source. Secondary text, 7.21:1." },
      "subtle": { "$type": "color", "$value": "#6c6676", "$description": "Floor for captions and labels, 5.21:1." },
      "border": { "$type": "color", "$value": "#776d83", "$description": "Source. Control borders, 4.88:1 on white." },
      "line": { "$type": "color", "$value": "#d3ccdc", "$description": "Source. Dividers and chip outlines." },
      "hairline": { "$type": "color", "$value": "#e5e1eb", "$description": "Card rings, table rules." },
      "paper": { "$type": "color", "$value": "#faf8f4", "$description": "Source. Page ground." },
      "white": { "$type": "color", "$value": "#ffffff", "$description": "Cards." },
      "watermark": { "$type": "color", "$value": "#efeaf3", "$description": "Decorative section words only." }
    }
  },
  "font": {
    "family": {
      "display": { "$type": "fontFamily", "$value": ["Iowan Old Style", "Palatino Linotype", "Palatino", "Book Antiqua", "Georgia", "serif"], "$description": "Headlines, quotations, numerals. Source face Georgia remains the last named fallback." },
      "ui": { "$type": "fontFamily", "$value": ["-apple-system", "BlinkMacSystemFont", "Segoe UI Variable Text", "Segoe UI", "Helvetica Neue", "sans-serif"] },
      "mono": { "$type": "fontFamily", "$value": ["ui-monospace", "SF Mono", "Cascadia Mono", "Segoe UI Mono", "Menlo", "Consolas", "monospace"], "$description": "Dates, locators, record values." }
    }
  },
  "typography": {
    "display-xl": { "$type": "typography", "$value": { "fontFamily": "{font.family.display}", "fontSize": "clamp(46px, 6.4vw, 94px)", "lineHeight": 0.98, "letterSpacing": "-0.02em", "fontWeight": 400 } },
    "display-l": { "$type": "typography", "$value": { "fontFamily": "{font.family.display}", "fontSize": "clamp(34px, 3.8vw, 52px)", "lineHeight": 1.06, "letterSpacing": "-0.012em", "fontWeight": 400 } },
    "display-m": { "$type": "typography", "$value": { "fontFamily": "{font.family.display}", "fontSize": "30px", "lineHeight": 1.2, "fontWeight": 400 } },
    "title": { "$type": "typography", "$value": { "fontFamily": "{font.family.display}", "fontSize": "25px", "lineHeight": 1.24, "fontWeight": 400 } },
    "quote": { "$type": "typography", "$value": { "fontFamily": "{font.family.display}", "fontSize": "17px", "lineHeight": 1.6, "fontWeight": 400 } },
    "lead": { "$type": "typography", "$value": { "fontFamily": "{font.family.ui}", "fontSize": "19px", "lineHeight": 1.58, "fontWeight": 400 } },
    "body": { "$type": "typography", "$value": { "fontFamily": "{font.family.ui}", "fontSize": "16px", "lineHeight": 1.625, "fontWeight": 400 } },
    "small": { "$type": "typography", "$value": { "fontFamily": "{font.family.ui}", "fontSize": "14px", "lineHeight": 1.55, "fontWeight": 400 } },
    "caption": { "$type": "typography", "$value": { "fontFamily": "{font.family.ui}", "fontSize": "13px", "lineHeight": 1.5, "fontWeight": 400 } },
    "eyebrow": { "$type": "typography", "$value": { "fontFamily": "{font.family.ui}", "fontSize": "12px", "lineHeight": 1.35, "letterSpacing": "0.14em", "fontWeight": 700, "textTransform": "uppercase" } },
    "record": { "$type": "typography", "$value": { "fontFamily": "{font.family.mono}", "fontSize": "12.5px", "lineHeight": 1.45, "fontWeight": 400 } },
    "figure": { "$type": "typography", "$value": { "fontFamily": "{font.family.display}", "fontSize": "64px", "lineHeight": 1, "fontWeight": 400, "fontVariantNumeric": "oldstyle-nums" } }
  },
  "space": {
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px" },
    "5": { "$type": "dimension", "$value": "24px" },
    "6": { "$type": "dimension", "$value": "32px" },
    "7": { "$type": "dimension", "$value": "48px" },
    "8": { "$type": "dimension", "$value": "64px" },
    "9": { "$type": "dimension", "$value": "96px" },
    "10": { "$type": "dimension", "$value": "128px" },
    "gutter": { "$type": "dimension", "$value": "clamp(20px, 4vw, 40px)" },
    "section": { "$type": "dimension", "$value": "120px", "$description": "72px at 650px and below." },
    "container": { "$type": "dimension", "$value": "1280px" }
  },
  "radius": {
    "tag": { "$type": "dimension", "$value": "2px" },
    "chip": { "$type": "dimension", "$value": "4px", "$description": "Source value for chips; fields." },
    "button": { "$type": "dimension", "$value": "6px", "$description": "Source value." },
    "card": { "$type": "dimension", "$value": "10px" }
  },
  "shadow": {
    "ring": { "$type": "shadow", "$value": "0 0 0 1px #e5e1eb" },
    "e1": { "$type": "shadow", "$value": "0 0 0 1px #e5e1eb, 0 1px 2px rgba(43,22,79,.06), 0 10px 24px -14px rgba(43,22,79,.28)", "$description": "An open card." },
    "e2": { "$type": "shadow", "$value": "0 0 0 1px #e5e1eb, 0 2px 4px rgba(43,22,79,.06), 0 30px 60px -28px rgba(43,22,79,.45)", "$description": "The coverage instrument." },
    "focus": { "$type": "shadow", "$value": "outline 3px #23202b, offset 4px, halo 0 0 0 6px #b7a57a", "$description": "Source treatment; outline turns white on purple grounds." }
  },
  "motion": {
    "fast": { "$type": "duration", "$value": "160ms", "$description": "Hover and press, ease-out." },
    "slow": { "$type": "duration", "$value": "240ms", "$description": "Disclosure, cubic-bezier(.2,.7,.2,1)." },
    "reduced": { "$type": "duration", "$value": "0ms", "$description": "prefers-reduced-motion: reduce." }
  },
  "breakpoint": {
    "wide": { "$type": "dimension", "$value": "1100px", "$description": "Filter rail becomes sticky above this width (and 860px tall); competency lanes go to two columns below it." },
    "tablet": { "$type": "dimension", "$value": "1000px", "$description": "Source breakpoint. Hero, coverage, explorer and agenda stack." },
    "narrow": { "$type": "dimension", "$value": "760px", "$description": "Source cards, scenarios and lanes go to one column." },
    "phone": { "$type": "dimension", "$value": "650px", "$description": "Source breakpoint. Phone type scale, watermarks hidden, nav scrolls." }
  },
  "contrast": [
    { "foreground": "#23202b", "background": "#faf8f4", "ratio": 15.08, "use": "Ink on paper" },
    { "foreground": "#57515f", "background": "#faf8f4", "ratio": 7.21, "use": "Muted on paper" },
    { "foreground": "#6c6676", "background": "#faf8f4", "ratio": 5.21, "use": "Subtle on paper (captions)" },
    { "foreground": "#4b2e83", "background": "#faf8f4", "ratio": 9.81, "use": "UW Purple on paper" },
    { "foreground": "#685933", "background": "#faf8f4", "ratio": 6.46, "use": "Gold 800 on paper" },
    { "foreground": "#4b2e83", "background": "#f0ebf6", "ratio": 8.88, "use": "UW Purple on Purple 100" },
    { "foreground": "#23202b", "background": "#f6f0e1", "ratio": 14.07, "use": "Ink on Gold 100" },
    { "foreground": "#ffffff", "background": "#4b2e83", "ratio": 10.41, "use": "White on UW Purple" },
    { "foreground": "#dbcdab", "background": "#4b2e83", "ratio": 6.61, "use": "Gold 300 on UW Purple" },
    { "foreground": "#b7a57a", "background": "#2a164f", "ratio": 6.54, "use": "UW Gold on Purple 900" },
    { "foreground": "#b7a57a", "background": "#4b2e83", "ratio": 4.30, "use": "UW Gold on UW Purple, 24px and larger only" },
    { "foreground": "#b7a57a", "background": "#ffffff", "ratio": 2.42, "use": "UW Gold on white, rules and ornament only" },
    { "foreground": "#776d83", "background": "#ffffff", "ratio": 4.88, "use": "Control borders (3:1 required)" }
  ]
}
